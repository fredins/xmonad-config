cabal-version: 3.0
name: xmonad-config
version: 0.1.0.0
author: Martin Fredin
maintainer: fredin.martin@gmail.com
build-type: Simple

common language
  default-language: Haskell2010
  ghc-options:
    -W
    -Wno-unused-matches
    -Wmissing-fields
    -Werror=missing-fields
    -Werror=unused-imports
    -Werror=incomplete-patterns
    -Werror=overlapping-patterns

  default-extensions:
    BangPatterns
    BlockArguments
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    DuplicateRecordFields
    EmptyCase
    ExistentialQuantification
    FlexibleContexts
    FlexibleInstances
    FunctionalDependencies
    GADTs
    GeneralizedNewtypeDeriving
    InstanceSigs
    ImportQualifiedPost
    LambdaCase
    LexicalNegation
    MultiParamTypeClasses
    MultiWayIf
    NoStarIsType
    OverloadedRecordDot
    NamedFieldPuns
    PartialTypeSignatures
    PatternSynonyms
    RankNTypes
    StandaloneDeriving
    StandaloneKindSignatures
    TupleSections
    TypeApplications
    TypeFamilies
    TypeFamilyDependencies
    TypeOperators
    TypeSynonymInstances

executable xmonad-config
  import: language
  main-is: Main.hs
  hs-source-dirs: src
  build-depends:
      base >= 4.22 && < 4.23
    , containers >= 0.7 && < 0.9
    , xmonad >= 0.17 && < 0.19
    , xmonad-contrib >= 0.18 && < 0.19
